DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Auth mobile : le JWT utilise NEXTAUTH_SECRET. Pas de variable supplémentaire requise.

# Gmail SMTP (optionnel) — pour envoyer des emails depuis ton adresse Gmail
# Les membres recevront les emails comme s'ils venaient de toi
# GMAIL_USER=ton@email.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_FROM_NAME="Ton Nom" (optionnel, défaut: TW3 Institute)
